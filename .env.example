# Zkopíruj jako .env. Na Vercelu nastav stejné klíče v Project → Settings → Environment Variables.

DATABASE_URL="postgresql://uzivatel:heslo@host/databaze?sslmode=require"

# Povinné v produkci. Bez něj je redakce na Vercelu zamčená.
AUTH_PASSWORD=""

# Povinné pro /api/cron/*. Bez něj cron vrací 401.
CRON_SECRET=""

# Povinné pro POST /api/admin/import-karty.
IMPORT_API_KEY=""

# Volitelné. Katalog a zdroje jdou přes Metal Archives a MusicBrainz i bez něj.
GEMINI_API_KEY=""

NEXT_PUBLIC_APP_URL="https://muflon-core.vercel.app"

# Sociální sítě (volitelné)
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""
INSTAGRAM_ACCOUNT_ID=""
