# Zkopíruj tento soubor jako .env a vlož skutečný connection string.
#
# Lokální vývoj (Vercel Postgres / Neon – "Show secrets" v Vercel dashboardu,
# nebo si vytvoř zdarma projekt na neon.tech):
DATABASE_URL="postgresql://uzivatel:heslo@host/databaze?sslmode=require"

# Heslo do redakce. Bez této proměnné je přihlášení vypnuté.
AUTH_PASSWORD=""

# Volitelné. Katalog a zdroje jdou přes Metal Archives a MusicBrainz i bez něj.
# Gemini se použije jen když klíč existuje a není 429.
GEMINI_API_KEY=""
